# Copy to .env (never commit .env). In production use your host's secrets vault.
# Sandbox restricted key while developing (rk_test_...). A live key is refused
# unless ALLOW_LIVE_KEYS=true, which you set only on the production server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_V2_WEBHOOK_SECRET=
APP_URL=http://localhost:4242
PLATFORM_FEE_BPS=150
# ALLOW_LIVE_KEYS=true

# --- BinaLab Studio (payment links) ---
# Firebase service account JSON (plain or base64). Not needed on Cloud Run in the same Google project.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=binalab-a7891
# Studio logins allowed to create payment links (comma separated)
STUDIO_ADMIN_EMAILS=
# Where Studio is hosted (CORS)
STUDIO_ORIGINS=https://binalab.my,https://www.binalab.my
